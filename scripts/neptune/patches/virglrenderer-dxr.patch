diff -ruN virgl-a/src/neptune/npt_dispatch.c virgl-b/src/neptune/npt_dispatch.c
--- a/src/neptune/npt_dispatch.c	2026-10-14 06:24:27.000000000 +0800
+++ b/src/neptune/npt_dispatch.c	2026-10-15 03:41:27.779263540 +0800
